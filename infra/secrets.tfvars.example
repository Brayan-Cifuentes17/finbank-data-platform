# secrets.tfvars.example
# COPIA este archivo como "secrets.tfvars" (sin .example) en esta misma carpeta,
# y completar con sus valores reales. secrets.tfvars esta en .gitignore es decir NUNCA se sube.
#
# Uso: terraform apply -var-file="dev.tfvars" -var-file="secrets.tfvars"

client_ip_address  = "la ip publica a la que esta conectado"        # obtenerla con: curl https://ifconfig.me/ip
alert_email         = "correo al que desea le llegue la alerta"
sql_admin_password  = "Contraseña-que-va-a-usar"     # min 8 caracteres, mayus+minus+numero+simbolo
